# Dockerfile for Fastify API service (Bun)
FROM oven/bun:1-alpine

WORKDIR /app

# Install curl for healthcheck
RUN apk add --no-cache curl

# Copy package files
COPY fastify-backend/package.json ./
COPY fastify-backend/bun.lock ./

# Install dependencies
RUN bun install --production

# Copy fastify backend code
COPY fastify-backend ./

# Create uploads and web-dist directories (will be mounted as volumes)
RUN mkdir -p uploads web-dist

# Expose port
EXPOSE 4000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:4000/health || exit 1

# Start server
CMD ["bun", "run", "server.ts"]
