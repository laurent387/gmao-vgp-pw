[Unit]
Description=Fastify API In-Spectra
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/rork-in-spectra-asset---control/fastify-backend
Environment=NODE_ENV=production
EnvironmentFile=/home/deploy/rork-in-spectra-asset---control/fastify-backend/.env
ExecStart=/usr/local/bin/bun run server.ts
Restart=always

[Install]
WantedBy=multi-user.target
